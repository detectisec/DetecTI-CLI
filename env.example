# DetecTI-CLI API Configuration Template
# Rename this file to .env or set the corresponding environment variables

# 1. Shodan API Key (Required for Shodan reconnaissance modules)
# Obtain at: https://account.shodan.io
SHODAN_API_KEY=your_shodan_api_key_here

# 2. NVD API Key (Optional - Increases NVD query speed from 6s delay to 0.6s)
# Obtain at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=your_nvd_api_key_here

# 3. WhoisFreaks API Key (Optional - Used in the advanced Reverse WHOIS module)
# Obtain at: https://whoisfreaks.com
WHOISFREAKS_API_KEY=your_whoisfreaks_api_key_here

# 4. Censys Platform API v3 (Optional - Censys Recon and CenQL Mapping Module)
# Obtain at: https://platform.censys.io (Personal Access Token - PAT)
CENSYS_PAT_TOKEN=your_censys_pat_token_here
# Optional for paid / multi-tenant accounts:
# CENSYS_ORG_ID=your_org_id_here
# Legacy (v1/v2 - Compatible fallback):
# CENSYS_API_ID=your_censys_api_id_here
# CENSYS_API_SECRET=your_censys_api_secret_here

# 5. GitHub Personal Access Token (Optional - For GitHub PoC searches)
# Obtain at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here
