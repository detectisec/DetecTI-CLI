@app.command(name="scan")
def scan_command(
    target: str = typer.Option(
        ...,
        "-t",
        "--target",
        help="Target IP, CIDR, domain, email, CVE, search query, or file:LIST.txt",
    ),
    modules: str = typer.Option(
        "all",
        "-m",
        "--modules",
        help="Comma-separated list of modules to execute (shodan, censys, crtsh, reverse_whois, nvd, exploitdb, all)",
    ),
    output_format: str = typer.Option(
        "table",
        "-o",
        "--format",
        help="Output report format: table, json, markdown, all",
    ),
    output_file: Optional[Path] = typer.Option(
        None,
        "-f",
        "--output-file",
        help="Custom file path to export the report (e.g., report.json or report.md)",
    ),
    output_dir: Optional[Path] = typer.Option(
        None,
        "-d",
        "--output-dir",
        help="Directory to save generated JSON/Markdown reports",
    ),
    cvss_filter: Optional[str] = typer.Option(
        None,
        "--cvss",
        help="Filter vulnerabilities by CVSS severity: critical, high, medium, low",
    ),
    create_db: Optional[str] = typer.Option(
        None,
        "--create-db",
        help="Create named database and store results (e.g. --create-db mycompany). Enables persistence automatically",
    ),
    db_path: Optional[Path] = typer.Option(
        None,
        "--db-path",
        help="Custom SQLite database path (default: ./data/dbs/<target>.sqlite)",
    ),
) -> None:
    """Execute complete attack surface mapping and threat intelligence analysis.
    
    Examples:
      detecti scan -t example.com --create-db mycompany
      detecti scan -t 192.168.1.0/24 --create-db network_scan
      detecti scan -t CVE-2021-44228 -o json
    """
    print_banner()

    # Parse modules list
    mod_list = [m.strip().lower() for m in modules.split(",") if m.strip()]

    print_section_header("Scan Configuration")
    console.print(f" [cyan]Target:[/cyan] [bold white]{target}[/bold white]")
    console.print(f" [cyan]Modules:[/cyan] [bold white]{', '.join(mod_list)}[/bold white]")
    if cvss_filter:
        console.print(f" [cyan]CVSS Filter:[/cyan] [bold yellow]{cvss_filter.upper()}[/bold yellow]")

    # Run async engine
    with Progress(
        SpinnerColumn(spinner_name="dots"),
        TextColumn("[progress.description]{task.description}"),
        console=console,
        transient=True,
    ) as progress:
        task_id = progress.add_task("[bold cyan]Initializing DetecTI-CLI Intelligence Engine...", total=None)

        def progress_cb(module_name: str, message: str) -> None:
            progress.update(task_id, description=f"[bold cyan][{module_name}][/bold cyan] {message}")

        engine = ThreatTrackEngine(progress_callback=progress_cb)
        result = asyncio.run(
            engine.scan(
                target=target,
                enabled_modules=mod_list,
                cvss_filter=cvss_filter,
            )
        )

        # Store in SQLite database if create_db is specified
        if create_db:
            try:
                from core.database.storage import DatabaseManager
                
                # Determine database path
                if create_db:
                    # Use custom database name
                    db_name = create_db if create_db.endswith('.sqlite') else f"{create_db}.sqlite"
                    final_db_path = Path.cwd() / "data" / "dbs" / db_name
                elif db_path:
                    final_db_path = db_path
                else:
                    final_db_path = DatabaseManager.get_db_path_for_target(target)
                
                progress.update(task_id, description="[bold cyan]Storing results in SQLite database...")
                db_manager = DatabaseManager(final_db_path)
                db_manager.store_scan_result(result)
                
                print_success(f"Scan results stored in database: [bold underline]{final_db_path.resolve()}[/bold underline]")
                print_info(f"Use 'detecti serve start --db {final_db_path.name}' to start web dashboard")
            except Exception as e:
                print_error(f"Failed to store results in database: {e}")

    # 1. Terminal Output (Organized by Host)
    if output_format.lower() in ("table", "all") or not output_file:
        render_scan_output(result)

        # Summary Panel
        console.print("")
        console.print(render_summary_panel(result.summary, result.elapsed_seconds))

    # 2. File Export Handling
    safe_target = "".join(c if c.isalnum() else "_" for c in target)[:40]
    timestamp = result.started_at.strftime("%Y%m%d_%H%M%S")

    save_dir = output_dir or Path.cwd()
    save_dir.mkdir(parents=True, exist_ok=True)

    # Determine what to export (supports explicit -o or inferred from -f extension)
    fmt = output_format.lower()
    export_json = fmt in ("json", "all") or (output_file and output_file.suffix == ".json")
    export_md = fmt in ("markdown", "md", "all") or (output_file and output_file.suffix in (".md", ".markdown"))

    # JSON Export
    if export_json:
        json_path = (
            output_file
            if output_file and output_file.suffix == ".json"
            else save_dir / f"detecti_{safe_target}_{timestamp}.json"
        )
        JSONReporter.save(result, json_path)
        print_success(f"JSON report saved to: [bold underline]{json_path.resolve()}[/bold underline]")

    # Markdown Export
    if export_md:
        md_path = (
            output_file
            if output_file and output_file.suffix in (".md", ".markdown")
            else save_dir / f"detecti_{safe_target}_{timestamp}.md"
        )
        MarkdownReporter.save(result, md_path)
        print_success(f"Markdown executive report saved to: [bold underline]{md_path.resolve()}[/bold underline]")


