@serve_app.command("start")
def start_server(
    db: str = typer.Option(
        ...,
        "--db",
        "-d",
        help="Target SQLite database file inside ./data/dbs/ or full path",
    ),
    port: int = typer.Option(
        8000,
        "--port",
        "-p",
        help="Port for the HTTP server",
    ),
    host: str = typer.Option(
        "127.0.0.1",
        "--host",
        "-h",
        help="Host binding address",
    ),
) -> None:
    """Start the non-blocking EASM graph webserver in the background."""
    print_banner()
    
    try:
        import fastapi
        import uvicorn
        import psutil
    except ImportError as e:
        print_error("Web server dependencies not installed. Run: pip install fastapi uvicorn psutil")
        return
    
    try:
        from web.process_manager import WebServerManager
        
        manager = WebServerManager()
        
        # Check if server is already running
        if manager.is_running():
            status = manager.get_status()
            if status:
                print_warning(f"Web server is already running on {status['host']}:{status['port']}")
                print_info(f"Database: {status['db_path']}")
                print_info(f"PID: {status['pid']}")
                return
        
        print_info(f"Starting DetecTI-CLI web server on {host}:{port}...")
        print_info(f"Database: {db}")
        
        # Start the server
        success = manager.start_server(db, host, port)
        
        if success:
            print_success(f"✅ Web server started successfully!")
            print_info(f"🌐 Dashboard URL: http://{host}:{port}")
            print_info(f"📊 Database: {db}")
            print_info("🔧 Use 'detecti serve status' to check server status")
            print_info("🛑 Use 'detecti serve stop' to stop the server")
            print_info("📱 Open your browser and navigate to the dashboard URL to view the EASM graph")
        else:
            print_error("❌ Failed to start web server")
            print_info("Check that the database file exists and the port is available")
            print_info("💡 Create a database first: 'detecti serve create-db --target <your_target>'")
            
    except FileNotFoundError as e:
        print_error(f"Database file not found: {e}")
    except Exception as e:
        print_error(f"Failed to start server: {e}")


@serve_app.command("status")
def server_status() -> None:
    """Check the status of the background webserver."""
    print_banner()
    
    try:
        import psutil
    except ImportError:
        print_error("Web server dependencies not installed. Run: pip install fastapi uvicorn psutil")
        return
    
    try:
        from web.process_manager import WebServerManager
        from rich.table import Table
        
        manager = WebServerManager()
        status = manager.get_status()
        
        if status:
            print_section_header("Web Server Status")
            
            # Create status table
            table = Table(show_header=True, header_style="bold cyan")
            table.add_column("Property", style="bold white")
            table.add_column("Value", style="green")
            
            table.add_row("Status", "🟢 RUNNING")
            table.add_row("PID", str(status['pid']))
            table.add_row("Host", status['host'])
            table.add_row("Port", str(status['port']))
            table.add_row("Database", status['db_path'])
            table.add_row("Started At", status.get('started_at', 'Unknown'))
            
            if 'uptime_seconds' in status:
                uptime = int(status['uptime_seconds'])
                hours, remainder = divmod(uptime, 3600)
                minutes, seconds = divmod(remainder, 60)
                uptime_str = f"{hours:02d}:{minutes:02d}:{seconds:02d}"
                table.add_row("Uptime", uptime_str)
            
            if 'memory_mb' in status:
                table.add_row("Memory Usage", f"{status['memory_mb']:.1f} MB")
            
            console.print(table)
            print_success(f"🌐 Dashboard URL: http://{status['host']}:{status['port']}")
        else:
            print_warning("🔴 Web server is not running")
            print_info("Use 'detecti serve start --db <database>' to start the server")
            
    except Exception as e:
        print_error(f"Failed to check server status: {e}")


@serve_app.command("stop")
def stop_server() -> None:
    """Stop the background webserver gracefully."""
    print_banner()
    
    try:
        import psutil
    except ImportError:
        print_error("Web server dependencies not installed. Run: pip install psutil")
        return
    
    try:
        from web.process_manager import WebServerManager
        
        manager = WebServerManager()
        
        if not manager.is_running():
            print_warning("🔴 Web server is not running")
            return
        
        print_info("🛑 Stopping web server...")
        
        success = manager.stop_server()
        
        if success:
            print_success("✅ Web server stopped successfully")
        else:
            print_error("❌ Failed to stop web server")
            print_info("The server process may have already terminated")
            
    except Exception as e:
        print_error(f"Failed to stop server: {e}")


@serve_app.command("list-dbs")
def list_databases() -> None:
    """List all available EASM target SQLite databases in ./data/dbs/."""
    print_banner()
    
    data_dir = Path.cwd() / "data" / "dbs"
    if not data_dir.exists():
        print_warning("No databases directory found. Run a scan with --persist to create databases.")
        return
    
    db_files = list(data_dir.glob("*.sqlite"))
    if not db_files:
        print_warning("No SQLite databases found in ./data/dbs/")
        return
    
    print_section_header(f"Available EASM Databases ({len(db_files)} found)")
    
    from rich.table import Table
    table = Table(show_header=True, header_style="bold cyan")
    table.add_column("Database File", style="bold white")
    table.add_column("Target", style="cyan")
    table.add_column("Size", style="dim")
    table.add_column("Modified", style="dim")
    
    for db_file in sorted(db_files):
        size_mb = db_file.stat().st_size / (1024 * 1024)
        modified = db_file.stat().st_mtime
        from datetime import datetime
        mod_time = datetime.fromtimestamp(modified).strftime("%Y-%m-%d %H:%M")
        
        # Try to get target from database
        target = "Unknown"
        try:
            from core.database.storage import DatabaseManager
            db_manager = DatabaseManager(db_file)
            stats = db_manager.get_summary_stats()
            if 'target' in stats:
                target = stats['target']
        except Exception:
            pass
        
        table.add_row(
            db_file.name,
            target,
            f"{size_mb:.2f} MB",
            mod_time
        )
    
    console.print(table)
    print_info("Use 'detecti serve start --db <database_name>' to start the web dashboard")


@serve_app.command("create-db")
def create_database(
    target: str = typer.Option(
        ...,
        "--target",
        "-t",
        help="Target to scan and create database for",
    ),
    modules: str = typer.Option(
        "all",
        "--modules",
        "-m",
        help="Comma-separated list of modules to execute",
    ),
    db_name: Optional[str] = typer.Option(
        None,
        "--db-name",
        "-n",
        help="Custom database name (default: auto-generated from target)",
    ),
    cvss_filter: Optional[str] = typer.Option(
        None,
        "--cvss",
        help="Filter vulnerabilities by CVSS severity: critical, high, medium, low",
    ),
) -> None:
    """Create a new EASM database by scanning a target."""
    print_banner()
    
    # Parse modules list
    mod_list = [m.strip().lower() for m in modules.split(",") if m.strip()]
    
    print_section_header("Creating EASM Database")
    console.print(f" [cyan]Target:[/cyan] [bold white]{target}[/bold white]")
    console.print(f" [cyan]Modules:[/cyan] [bold white]{', '.join(mod_list)}[/bold white]")
    
    # Determine database path
    from core.database.storage import DatabaseManager
    if db_name:
        if not db_name.endswith('.sqlite'):
            db_name += '.sqlite'
        db_path = Path.cwd() / "data" / "dbs" / db_name
    else:
        db_path = DatabaseManager.get_db_path_for_target(target)
    
    console.print(f" [cyan]Database:[/cyan] [bold white]{db_path.name}[/bold white]")
    
    if db_path.exists():
        print_warning(f"Database already exists: {db_path.name}")
        if not typer.confirm("Do you want to overwrite it?"):
            print_info("Operation cancelled.")
            return
        db_path.unlink()
    
    # Run scan with persistence
    with Progress(
        SpinnerColumn(spinner_name="dots"),
        TextColumn("[progress.description]{task.description}"),
        console=console,
        transient=True,
    ) as progress:
        task_id = progress.add_task("[bold cyan]Scanning target and creating database...", total=None)

        def progress_cb(module_name: str, message: str) -> None:
            progress.update(task_id, description=f"[bold cyan][{module_name}][/bold cyan] {message}")

        engine = ThreatTrackEngine(progress_callback=progress_cb)
        result = asyncio.run(
            engine.scan(
                target=target,
                enabled_modules=mod_list,
                cvss_filter=cvss_filter,
            )
        )

        # Store in database
        progress.update(task_id, description="[bold cyan]Storing results in SQLite database...")
        db_manager = DatabaseManager(db_path)
        db_manager.store_scan_result(result)

    print_success(f"✅ Database created successfully: [bold underline]{db_path.resolve()}[/bold underline]")
    print_info(f"📊 Stored {len(result.hosts)} hosts and {len(result.findings)} findings")
    print_info(f"🌐 Start web dashboard: [bold]detecti serve start --db {db_path.name}[/bold]")


